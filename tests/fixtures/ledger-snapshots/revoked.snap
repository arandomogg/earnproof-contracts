# scenario: revoked
# revision: 5
# reason: issuer-registry init now stores ActiveIssuerCount MaxActiveIssuers ReactivationCooldown and IssuerEpoch keys
# body-digest: 61046e3613fa4a9f1d0bc92d87928a31e354ae45f1a64c9838152ee493df84cc

[ledger]
sequence = 1000
timestamp = 1000

[storage]
issuer-registry instance [sym:ActiveIssuerCount] = u32:0
issuer-registry instance [sym:Admin] = addr:admin
issuer-registry instance [sym:ContractVersion] = u32:1
issuer-registry instance [sym:IssuerEpoch] = u64:2
issuer-registry instance [sym:MaxActiveIssuers] = u32:4294967295
issuer-registry instance [sym:ReactivationCooldown] = u64:0
issuer-registry persistent [sym:AddressIssuer, addr:issuer] = bytes:1111111111111111111111111111111111111111111111111111111111111111
issuer-registry persistent [sym:Issuer, bytes:1111111111111111111111111111111111111111111111111111111111111111] = {sym:created_at: u64:1000, sym:issuer_address: addr:issuer, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:metadata_hash: bytes:2222222222222222222222222222222222222222222222222222222222222222, sym:status: [sym:Revoked], sym:updated_at: u64:1000}
proof-registry instance [sym:Admin] = addr:admin
proof-registry instance [sym:ContractVersion] = u32:1
proof-registry instance [sym:IssuerRegistry] = addr:issuer-registry
proof-registry instance [sym:ProtocolConfig] = addr:protocol-config
proof-registry persistent [sym:Proof, bytes:3333333333333333333333333333333333333333333333333333333333333333] = {sym:commitment_hash: bytes:4444444444444444444444444444444444444444444444444444444444444444, sym:created_at: u64:1000, sym:expires_at: u64:2000, sym:issuer_address: addr:issuer, sym:proof_id_hash: bytes:3333333333333333333333333333333333333333333333333333333333333333, sym:revoked_at: u64:1000, sym:schema_version: u32:1, sym:status: [sym:Revoked]}
protocol-config instance [sym:Admin] = addr:admin
protocol-config instance [sym:ConfigVersion] = u32:2
protocol-config instance [sym:ContractVersion] = u32:1
protocol-config instance [sym:Paused] = false
protocol-config persistent [sym:SchemaVersion, u32:1] = true

[events]
protocol-config topics=[sym:initialized] data={sym:admin: addr:admin}
protocol-config topics=[sym:schema_approved] data={sym:version: u32:1}
issuer-registry topics=[sym:issuer_registered] data={sym:created_at: u64:1000, sym:epoch: u64:1, sym:issuer_address: addr:issuer, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:metadata_hash: bytes:2222222222222222222222222222222222222222222222222222222222222222}
issuer-registry topics=[sym:issuer_revoked] data={sym:epoch: u64:2, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:updated_at: u64:1000}

[verdicts]
protocol-config.is_paused = false
protocol-config.is_schema_version_approved(1) = true
issuer-registry.is_active_address(issuer) = false
proof-registry.is_valid_proof(proof) = false
proof-registry.is_revoked(proof) = true
