      "auth": "none",
      "effects": "extends TTL on read"
    },
    {
      "name": "is_valid_proof",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "proof_id_hash", "type": "BytesN<32>" }
      ],
      "output": "bool",
      "access": "public",
      "auth": "none",
      "note": "Returns true only if status == Active AND expires_at > now"
    },
    {
      "name": "is_revoked",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "proof_id_hash", "type": "BytesN<32>" }
      ],
      "output": "bool",
      "access": "public",
      "auth": "none"
    },
