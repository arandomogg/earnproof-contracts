      "Any removal of public functions",
      "Any change to DataKey enum variants",
      "Any change to stored value types",
      "Any removal or renaming of events"
    ],
    "additive_changes": [
      "New public functions",
      "New error variants (with higher codes)",
      "New storage keys",
      "New event fields (backward-compatible)"
    ]
  }
}
