{
  "$schema": "earnproof-contract-abi/v1",
  "contract": "ProtocolConfigContract",
  "soroban_sdk_version": "27.0.0",
  "rust_toolchain": "1.98.0",
  "generated_from": "Part 1 analysis - synthetic values only",
  "note": "Golden artifact — update with scripts/update-goldens.sh after intentional breaking changes. Requires version bump and migration note in docs/releases/",
  
  "functions": [
    {
