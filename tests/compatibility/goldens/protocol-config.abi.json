        { "name": "admin", "type": "Address" }
      ],
      "output": "Result<(), ContractError>",
      "access": "public",
      "auth": "admin.require_auth()",
      "guards": ["AlreadyInitialized"]
    },
    {
      "name": "get_admin",
      "inputs": [
        { "name": "env", "type": "Env" }
      ],
      "output": "Result<Address, ContractError>",
      "access": "public",
      "auth": "none"
    },
    {
      "name": "set_admin",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "new_admin", "type": "Address" }
      ],
      "output": "Result<(), ContractError>",
      "access": "public",
      "auth": "admin_only",
      "effects": "bumps ConfigVersion, emits AdminChanged"
    },
    {
      "name": "is_paused",
      "inputs": [
        { "name": "env", "type": "Env" }
      ],
      "output": "bool",
      "access": "public",
      "auth": "none"
    },
    {
      "name": "pause",
      "inputs": [
        { "name": "env", "type": "Env" }
      ],
      "output": "Result<(), ContractError>",
      "access": "public",
      "auth": "admin_only",
      "effects": "bumps ConfigVersion, emits Paused"
    },
    {
      "name": "unpause",
      "inputs": [
        { "name": "env", "type": "Env" }
      ],
      "output": "Result<(), ContractError>",
      "access": "public",
      "auth": "admin_only",
      "effects": "bumps ConfigVersion, emits Unpaused"
    },
    {
      "name": "approve_schema_version",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "version", "type": "u32" }
      ],
      "output": "Result<(), ContractError>",
      "access": "public",
      "auth": "admin_only",
      "validation": "version > 0",
      "effects": "bumps ConfigVersion, emits SchemaApproved"
    },
    {
      "name": "deprecate_schema_version",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "version", "type": "u32" }
      ],
      "output": "Result<(), ContractError>",
      "access": "public",
      "auth": "admin_only",
      "validation": "version > 0",
      "effects": "bumps ConfigVersion, emits SchemaDeprecated"
    },
    {
      "name": "is_schema_version_approved",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "version", "type": "u32" }
      ],
      "output": "bool",
      "access": "public",
      "auth": "none",
      "note": "Returns false if version == 0; extends TTL on read"
    },
    {
      "name": "get_config_version",
      "inputs": [
        { "name": "env", "type": "Env" }
      ],
      "output": "u32",
      "access": "public",
      "auth": "none"
    },
    {
      "name": "get_contract_version",
      "inputs": [
        { "name": "env", "type": "Env" }
      ],
      "output": "u32",
      "access": "public",
      "auth": "none",
      "note": "Monotonic upgrade counter; separate from ConfigVersion"
    },
    {
      "name": "approve_upgrade",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "wasm_hash", "type": "BytesN<32>" },
        { "name": "new_version", "type": "u32" }
      ],
      "output": "void",
      "access": "public",
      "auth": "admin_only",
      "guards": ["panics if new_version <= current_version"],
      "effects": "stores AllowedWasm allowlist entry, emits UpgradeAllowlisted"
    },
    {
      "name": "revoke_upgrade",
      "inputs": [
        { "name": "env", "type": "Env" },
        { "name": "wasm_hash", "type": "BytesN<32>" }
